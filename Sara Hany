# Silent Auction

print("Welcome to our Game!!!")

max_price = 0
win_name = ""

User_data = {}         # the library

while True:
    name = input("Enter your name: ")
    price = float(input("Enter your price: "))
    User_data[name] = price

    if price > max_price:
        max_price = price
        win_name = name

        condition = input("Is there another player ? (YES/NO)").lower()
        print("\n"*200)

        if condition == "no":
            break

print(f'{win_name} is the winner with price {max_price}$')
